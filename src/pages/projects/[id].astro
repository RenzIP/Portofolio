---
/**
 * projects/[id] — isi satu file proyek.
 */
import { getCollection, render } from "astro:content";
import RepoLayout from "../../layouts/RepoLayout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { title, summary, tags, date, repo, demo, status } = project.data;
const { Content } = await render(project);

const formattedDate = date.toLocaleDateString("id-ID", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const statusTone: Record<string, string> = {
  aktif: "border-add/40 bg-add-bg text-add",
  selesai: "border-rule-strong bg-paper-soft text-ink-soft",
  arsip: "border-rule-strong bg-paper-soft text-ink-faint",
};
---

<RepoLayout title={title} description={summary} file={`projects/${project.id}.md`}>
  <a
    href="/projects"
    class="mb-6 inline-block text-xs text-ink-faint transition-colors hover:text-accent-700"
  >
    ← projects/
  </a>

  <article>
    <header class="mb-6 border-b border-rule pb-6">
      <h1 class="mb-3 font-display text-3xl font-bold tracking-tight text-ink">
        {title}
      </h1>
      <p class="mb-4 max-w-2xl text-sm leading-relaxed text-ink-soft">
        {summary}
      </p>

      <div class="flex flex-wrap items-center gap-3 text-xs">
        <time datetime={date.toISOString()} class="text-ink-faint">
          {formattedDate}
        </time>
        {
          status && (
            <span
              class:list={[
                "rounded-xs border px-1.5 py-px tracking-wide uppercase",
                statusTone[status] ?? statusTone.selesai,
              ]}
            >
              {status}
            </span>
          )
        }
        <ul class="flex flex-wrap gap-1.5">
          {tags.map((tag) => (
            <li class="chip">{tag}</li>
          ))}
        </ul>
      </div>

      {
        (repo || demo) && (
          <div class="mt-5 flex gap-2">
            {repo && (
              <a
                href={repo}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-md border border-rule-strong px-3 py-1.5 text-xs font-medium text-ink-soft transition-colors hover:border-accent-400 hover:text-accent-700"
              >
                source ↗
              </a>
            )}
            {demo && (
              <a
                href={demo}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-md bg-ink px-3 py-1.5 text-xs font-medium text-paper transition-colors hover:bg-accent-700"
              >
                live ↗
              </a>
            )}
          </div>
        )
      }
    </header>

    <div
      class="prose prose-sm max-w-none prose-headings:font-display prose-headings:font-semibold prose-headings:text-ink prose-p:text-ink-soft prose-a:text-accent-700 prose-strong:text-ink prose-code:rounded-xs prose-code:bg-paper-sunk prose-code:px-1 prose-code:py-0.5 prose-code:text-accent-800 prose-code:before:content-none prose-code:after:content-none prose-li:text-ink-soft"
    >
      <Content />
    </div>
  </article>
</RepoLayout>
