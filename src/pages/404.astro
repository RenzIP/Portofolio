---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 — Halaman Tidak Ditemukan">
  <div class="flex flex-col items-center justify-center py-24 text-center">
    <p class="mb-4 font-mono text-6xl font-bold text-brand-600 dark:text-brand-400">
      404
    </p>
    <h1 class="mb-3 text-2xl font-semibold text-slate-900 dark:text-slate-100">
      Halaman tidak ditemukan
    </h1>
    <p class="mb-8 text-slate-600 dark:text-slate-400">
      Alamat yang Anda tuju tidak ada atau sudah dipindahkan.
    </p>
    <a
      href="/"
      class="rounded-lg bg-brand-600 px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-brand-700"
    >
      Kembali ke Home
    </a>
  </div>
</Layout>
