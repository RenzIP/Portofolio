---
/**
 * CONTACT.md — kontak sebagai file markdown.
 */
import RepoLayout from "../layouts/RepoLayout.astro";
import { repo, socials } from "../data/site";
---

<RepoLayout
  title="CONTACT"
  file="CONTACT.md"
  description="Cara menghubungi saya untuk kolaborasi atau peluang kerja."
>
  <header class="mb-8">
    <h1 class="mb-2 flex items-baseline gap-2 font-display text-2xl font-bold text-ink">
      <span class="text-accent-500" aria-hidden="true">##</span>
      CONTACT.md
    </h1>
    <p class="max-w-2xl text-sm leading-relaxed text-ink-soft">
      Punya proyek, pertanyaan, atau ingin berkolaborasi? Saya senang mendengarnya.
      Cara tercepat adalah lewat email.
    </p>
  </header>

  <section class="mb-10">
    <p class="meta-label mb-3">$ git remote -v</p>
    <ul class="space-y-2">
      {
        socials.map((social) => (
          <li>
            <a
              href={social.href}
              target={social.href.startsWith("mailto:") ? undefined : "_blank"}
              rel="noopener noreferrer"
              class="group flex items-center gap-3 rounded-md border border-rule bg-paper px-4 py-3 transition-colors hover:border-accent-400"
            >
              <span class="text-xs text-ink-faint">{social.label.toLowerCase()}</span>
              <span class="ml-auto truncate text-sm text-ink-soft transition-colors group-hover:text-accent-700">
                {social.handle}
              </span>
              <span class="shrink-0 text-ink-faint transition-colors group-hover:text-accent-600" aria-hidden="true">
                ↗
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="code-block p-5">
    <p class="meta-label mb-3">// preferensi kerja</p>
    <dl class="space-y-2 text-sm">
      <div class="flex gap-4">
        <dt class="w-24 shrink-0 text-ink-faint">lokasi</dt>
        <dd class="text-ink-soft">{repo.location}</dd>
      </div>
      <div class="flex gap-4">
        <dt class="w-24 shrink-0 text-ink-faint">status</dt>
        <dd class="flex items-center gap-1.5 text-ink-soft">
          <span class="size-1.5 rounded-full bg-add" aria-hidden="true"></span>
          {repo.status}
        </dd>
      </div>
      <div class="flex gap-4">
        <dt class="w-24 shrink-0 text-ink-faint">fokus</dt>
        <dd class="text-ink-soft">Web full-stack · antarmuka &amp; API</dd>
      </div>
    </dl>
  </section>
</RepoLayout>
