---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { site } from "../data/site";

const featured = (await getCollection("projects"))
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);
---

<Layout title="Portofolio" description={site.tagline}>
  <section class="mb-20">
    <p class="mb-3 font-mono text-sm text-brand-600 dark:text-brand-400">
      Halo, saya {site.name} 👋
    </p>
    <h1
      class="mb-6 max-w-3xl text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl dark:text-slate-100"
    >
      {site.role} yang suka membangun produk rapi dan cepat.
    </h1>
    <p class="mb-8 max-w-2xl text-lg leading-relaxed text-slate-600 dark:text-slate-400">
      {site.tagline}
    </p>
    <div class="flex flex-wrap gap-3">
      <a
        href="/projects"
        class="rounded-lg bg-brand-600 px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-brand-700"
      >
        Lihat Proyek
      </a>
      <a
        href="/contact"
        class="rounded-lg border border-slate-300 px-5 py-2.5 text-sm font-medium text-slate-700 transition-colors hover:border-brand-400 hover:text-brand-700 dark:border-slate-700 dark:text-slate-300 dark:hover:border-brand-600 dark:hover:text-brand-400"
      >
        Hubungi Saya
      </a>
    </div>
  </section>

  <section class="mb-20">
    <h2 class="mb-6 text-2xl font-semibold text-slate-900 dark:text-slate-100">
      Keahlian
    </h2>
    <div class="grid gap-6 sm:grid-cols-2">
      {
        site.skills.map(({ group, items }) => (
          <div class="rounded-xl border border-slate-200 p-5 dark:border-slate-800">
            <h3 class="mb-3 text-sm font-semibold text-slate-900 dark:text-slate-100">
              {group}
            </h3>
            <ul class="flex flex-wrap gap-2">
              {items.map((item) => (
                <li class="rounded-md bg-slate-100 px-2.5 py-1 font-mono text-xs text-slate-700 dark:bg-slate-800 dark:text-slate-300">
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section>
    <div class="mb-6 flex items-baseline justify-between">
      <h2 class="text-2xl font-semibold text-slate-900 dark:text-slate-100">
        Proyek Unggulan
      </h2>
      <a
        href="/projects"
        class="text-sm text-brand-600 hover:underline dark:text-brand-400"
      >
        Semua proyek →
      </a>
    </div>
    <div class="grid gap-5 sm:grid-cols-2">
      {featured.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>
</Layout>
