---
/**
 * Halaman utama — dibingkai sebagai README.md
 */
import { getCollection } from "astro:content";
import RepoLayout from "../layouts/RepoLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import CommitGraph from "../components/CommitGraph.astro";
import { repo, commits } from "../data/site";

const featured = (await getCollection("projects"))
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);
---

<RepoLayout title="README" file="README.md">
  <!-- Blok intro gaya blok kode komentar -->
  <section class="mb-14">
    <div class="code-block mb-6 p-5">
      <p class="meta-label mb-2">$ whoami</p>
      <h1
        class="font-display text-3xl leading-tight font-bold tracking-tight text-ink sm:text-4xl"
      >
        {repo.owner}
      </h1>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-ink-soft sm:text-base">
        {repo.tagline}
      </p>
      <p class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-ink-faint">
        <span>📍 {repo.location}</span>
        <span class="flex items-center gap-1.5">
          <span class="size-1.5 rounded-full bg-add" aria-hidden="true"></span>
          {repo.status}
        </span>
      </p>
    </div>

    <div class="flex flex-wrap gap-2">
      <a
        href="/projects"
        class="rounded-md bg-ink px-4 py-2 text-xs font-medium text-paper transition-colors hover:bg-accent-700"
      >
        Lihat proyek →
      </a>
      <a
        href="/contact"
        class="rounded-md border border-rule-strong px-4 py-2 text-xs font-medium text-ink-soft transition-colors hover:border-accent-400 hover:text-accent-700"
      >
        Hubungi saya
      </a>
    </div>
  </section>

  <!-- ## About -->
  <section class="mb-14">
    <h2
      class="mb-4 flex items-baseline gap-2 font-display text-xl font-semibold text-ink"
    >
      <span class="text-accent-500" aria-hidden="true">##</span>
      Tentang
    </h2>
    <div class="space-y-3 border-l-2 border-rule pl-5">
      {
        repo.about.map((paragraph) => (
          <p class="max-w-3xl text-sm leading-relaxed text-ink-soft">
            {paragraph}
          </p>
        ))
      }
    </div>
  </section>

  <!-- ## Featured projects -->
  <section class="mb-14">
    <div class="mb-4 flex items-baseline justify-between gap-4">
      <h2
        class="flex items-baseline gap-2 font-display text-xl font-semibold text-ink"
      >
        <span class="text-accent-500" aria-hidden="true">##</span>
        Proyek unggulan
      </h2>
      <a
        href="/projects"
        class="shrink-0 text-xs text-ink-faint transition-colors hover:text-accent-700"
      >
        semua →
      </a>
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
      {featured.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <!-- ## Recent commits -->
  <section>
    <h2
      class="mb-4 flex items-baseline gap-2 font-display text-xl font-semibold text-ink"
    >
      <span class="text-accent-500" aria-hidden="true">##</span>
      Aktivitas terbaru
    </h2>
    <div class="code-block p-5">
      <p class="meta-label mb-4">$ git log --oneline</p>
      <CommitGraph commits={commits} />
    </div>
  </section>
</RepoLayout>
