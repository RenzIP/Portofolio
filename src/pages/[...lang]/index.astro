---
/**
 * Halaman utama — dibingkai sebagai README.md.
 *
 * Satu file ini menghasilkan SEMUA bahasa: `/` (id), `/en/`, `/ja/`, `/zh/`.
 * Rest parameter `[...lang]` boleh kosong, jadi home bahasa default tidak
 * perlu punya file terpisah.
 */
import { getCollection } from "astro:content";
import RepoLayout from "../../layouts/RepoLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import CommitGraph from "../../components/CommitGraph.astro";
import { commits, repo } from "../../data/site";
import { ui } from "../../i18n/ui";
import {
  getLang,
  locales,
  localizePath,
  projectLang,
  t,
  type Lang,
} from "../../i18n/utils";

export function getStaticPaths() {
  return [
    { params: { lang: undefined } },
    ...locales
      .filter((code) => code !== "id")
      .map((code) => ({ params: { lang: code } })),
  ];
}

const lang: Lang = getLang(Astro.params.lang);

// Entri konten punya id seperti "gradi-ol" (id) atau "en/gradi-ol" (lainnya).
// Ambil hanya entri milik bahasa halaman ini.
const featured = (await getCollection("projects"))
  .filter((p) => projectLang(p.id) === lang && p.data.featured)
  .sort((a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0))
  .slice(0, 6);

const aboutParagraphs = ui[lang].about;
const projectsUrl = localizePath("/projects", lang);
const contactUrl = localizePath("/contact", lang);
---

<RepoLayout title="README" file="README.md" lang={lang}>
  <!-- Blok intro gaya blok kode komentar -->
  <section class="reveal mb-14">
    <div class="code-block relative overflow-hidden p-6 sm:p-8">
      <!-- Top studio accent line: Marigold - Verdigris - Raspberry -->
      <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-accent-500 via-verdigris-500 to-rose-500"></div>

      <div class="flex flex-wrap items-center justify-between gap-2 border-b border-rule pb-4 mb-5">
        <div class="flex items-center gap-2">
          <span class="inline-block size-2 rounded-full bg-accent-500"></span>
          <span class="meta-label font-mono text-xs">git status --short</span>
        </div>
        <span class="inline-flex items-center gap-1.5 rounded-full border border-verdigris-200 bg-verdigris-50 px-2.5 py-0.5 text-[0.68rem] font-medium text-verdigris-700">
          <span class="size-1.5 rounded-full bg-verdigris-500 animate-pulse" aria-hidden="true"></span>
          {t(lang, "status")}
        </span>
      </div>

      <h1 class="font-display text-3xl leading-tight font-bold tracking-tight text-ink sm:text-5xl">
        {repo.author}<span class="caret" aria-hidden="true"></span>
      </h1>
      <p class="mt-4 max-w-2xl font-sans text-base leading-relaxed text-ink-soft sm:text-lg">
        {t(lang, "tagline")}
      </p>

      <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-rule pt-4 text-xs text-ink-faint">
        <span class="flex items-center gap-1.5">
          <span class="text-rose-500 font-bold">●</span> Bandung, Indonesia
        </span>
        <span class="flex items-center gap-1.5">
          <span class="text-verdigris-500 font-bold">●</span> GitHub: @{repo.owner}
        </span>
        <span class="flex items-center gap-1.5">
          <span class="text-accent-600 font-bold">●</span> Branch: main (clean)
        </span>
      </div>
    </div>

    <div class="flex flex-wrap gap-3 mt-4">
      <a
        href={projectsUrl}
        class="pressable inline-flex items-center gap-2 rounded-md bg-verdigris-600 px-5 py-2.5 text-xs font-semibold tracking-wide text-white shadow-sm hover:bg-verdigris-700"
      >
        <span>{t(lang, "ctaProjects")}</span>
        <span aria-hidden="true">→</span>
      </a>
      <a
        href={contactUrl}
        class="pressable inline-flex items-center gap-2 rounded-md border border-rule-strong bg-paper px-5 py-2.5 text-xs font-semibold text-ink-soft hover:border-accent-500 hover:text-accent-700"
      >
        <span>{t(lang, "ctaContact")}</span>
      </a>
    </div>
  </section>

  <!-- ## About -->
  <section class="mb-14" data-reveal>
    <h2
      class="mb-4 flex items-baseline gap-2 font-display text-xl font-semibold text-ink"
    >
      <span class="text-accent-500" aria-hidden="true">##</span>
      {t(lang, "secAbout")}
    </h2>
    <div class="space-y-3 border-l-2 border-rule pl-5">
      {
        aboutParagraphs.map((paragraph) => (
          <p class="max-w-3xl text-sm leading-relaxed text-ink-soft">
            {paragraph}
          </p>
        ))
      }
    </div>
  </section>

  <!-- ## Featured projects -->
  <section class="mb-14" data-reveal>
    <div class="mb-4 flex items-baseline justify-between gap-4">
      <h2
        class="flex items-baseline gap-2 font-display text-xl font-semibold text-ink"
      >
        <span class="text-accent-500" aria-hidden="true">##</span>
        {t(lang, "secFeatured")}
      </h2>
      <a
        href={projectsUrl}
        class="shrink-0 text-xs text-ink-faint transition-colors hover:text-accent-700"
      >
        {t(lang, "seeAll")}
      </a>
    </div>
    <div class="reveal-stagger grid gap-4 sm:grid-cols-2">
      {featured.map((project) => <ProjectCard project={project} lang={lang} />)}
    </div>
  </section>

  <!-- ## Recent commits -->
  <section data-reveal>
    <h2
      class="mb-4 flex items-baseline gap-2 font-display text-xl font-semibold text-ink"
    >
      <span class="text-accent-500" aria-hidden="true">##</span>
      {t(lang, "secActivity")}
    </h2>
    <div class="code-block p-5">
      <p class="meta-label mb-4">$ git log --oneline</p>
      <CommitGraph commits={commits} lang={lang} />
    </div>
  </section>
</RepoLayout>
