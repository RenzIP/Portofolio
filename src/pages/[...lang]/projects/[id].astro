---
/**
 * projects/[id] — isi satu file proyek.
 *
 * Satu route ini melayani semua bahasa: `/projects/gradi-ol`,
 * `/en/projects/gradi-ol`, `/ja/...`, `/zh/...`. Entri konten bahasa lain
 * punya id ber-prefix ("en/gradi-ol"), yang dipisah oleh `projectLang`
 * dan `projectSlug`.
 */
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import RepoLayout from "../../../layouts/RepoLayout.astro";
import {
  getLang,
  localizePath,
  projectLang,
  projectSlug,
  t,
  type Lang,
} from "../../../i18n/utils";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => {
    const lang = projectLang(project.id);
    return {
      params: {
        lang: lang === "id" ? undefined : lang,
        id: projectSlug(project.id),
      },
      props: { project },
    };
  });
}

const { project } = Astro.props;
const lang: Lang = getLang(Astro.params.lang as string | undefined);
const { title, summary, tags, date, repo, demo, status, cover } = project.data;
const { Content } = await render(project);

const formattedDate = date?.toLocaleDateString(lang === "id" ? "id-ID" : lang, {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const statusTone: Record<string, string> = {
  aktif: "border-add/40 bg-add-bg text-add",
  selesai: "border-rule-strong bg-paper-soft text-ink-soft",
  arsip: "border-rule-strong bg-paper-soft text-ink-faint",
};

const statusLabel: Record<string, "projActive" | "projDone" | "projArchived"> = {
  aktif: "projActive",
  selesai: "projDone",
  arsip: "projArchived",
};

// Structured data khusus proyek: SoftwareSourceCode + CreativeWork.
const projectSchema = {
  mainEntity: {
    "@type": "SoftwareSourceCode",
    name: title,
    description: summary,
    ...(date ? { dateCreated: date.toISOString() } : {}),
    keywords: tags.join(", "),
    ...(repo ? { codeRepository: repo } : {}),
    ...(demo ? { url: demo } : {}),
    programmingLanguage: tags,
    author: { "@id": `${Astro.site?.origin ?? Astro.url.origin}/#person` },
  },
};
---

<RepoLayout
  title={title}
  description={summary}
  file={`projects/${projectSlug(project.id)}.md`}
  schemaExtra={projectSchema}
  lang={lang}
>
  <a
    href={localizePath("/projects", lang)}
    class="mb-6 inline-block text-xs text-ink-faint transition-colors hover:text-accent-700"
  >
    {t(lang, "projBack")}
  </a>

  <article>
    <header class="mb-6 border-b border-rule pb-6">
      <h1 class="mb-3 font-display text-3xl font-bold tracking-tight text-ink">
        {title}
      </h1>
      <p class="mb-4 max-w-2xl text-sm leading-relaxed text-ink-soft">
        {summary}
      </p>

      {
        cover && (
          <div class="mb-5 overflow-hidden rounded-md border border-rule">
            <Image
              src={cover}
              alt={t(lang, "projImageAlt", { title })}
              widths={[600, 900, 1200]}
              sizes="(max-width: 1024px) 100vw, 900px"
              loading="eager"
              decoding="async"
              fetchpriority="high"
              class="aspect-[1200/630] w-full object-cover"
            />
          </div>
        )
      }

      <div class="flex flex-wrap items-center gap-3 text-xs">
        {
          date && (
            <time datetime={date.toISOString()} class="text-ink-faint">
              {formattedDate}
            </time>
          )
        }
        {
          status && (
            <span
              class:list={[
                "rounded-xs border px-1.5 py-px tracking-wide uppercase",
                statusTone[status] ?? statusTone.selesai,
              ]}
            >
              {t(lang, statusLabel[status] ?? "projDone")}
            </span>
          )
        }
        <ul class="flex flex-wrap gap-1.5">
          {tags.map((tag) => (
            <li class="chip">{tag}</li>
          ))}
        </ul>
      </div>

      {
        (repo || demo) && (
          <div class="mt-5 flex gap-2">
            {repo && (
              <a
                href={repo}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-md border border-rule-strong px-3 py-1.5 text-xs font-medium text-ink-soft transition-colors hover:border-accent-400 hover:text-accent-700"
              >
                {t(lang, "projSource")}
              </a>
            )}
            {demo && (
              <a
                href={demo}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-md bg-ink px-3 py-1.5 text-xs font-medium text-paper transition-colors hover:bg-accent-700"
              >
                {t(lang, "projLive")}
              </a>
            )}
          </div>
        )
      }
    </header>

    <div
      class="prose prose-sm max-w-none prose-headings:font-display prose-headings:font-semibold prose-headings:text-ink prose-p:text-ink-soft prose-a:text-accent-700 prose-strong:text-ink prose-code:rounded-xs prose-code:bg-paper-sunk prose-code:px-1 prose-code:py-0.5 prose-code:text-accent-800 prose-code:before:content-none prose-code:after:content-none prose-li:text-ink-soft"
    >
      <Content />
    </div>
  </article>
</RepoLayout>
