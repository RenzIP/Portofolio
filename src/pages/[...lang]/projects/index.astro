---
/**
 * projects/ — daftar semua proyek, seperti isi direktori.
 */
import { getCollection } from "astro:content";
import RepoLayout from "../../../layouts/RepoLayout.astro";
import ProjectCard from "../../../components/ProjectCard.astro";
import {
  getLang,
  locales,
  projectLang,
  t,
  type Lang,
} from "../../../i18n/utils";

export function getStaticPaths() {
  return [
    { params: { lang: undefined } },
    ...locales
      .filter((code) => code !== "id")
      .map((code) => ({ params: { lang: code } })),
  ];
}

const lang: Lang = getLang(Astro.params.lang);

const projects = (await getCollection("projects"))
  .filter((p) => projectLang(p.id) === lang)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<RepoLayout title="projects" file="projects/" lang={lang}>
  <header class="reveal mb-8">
    <h1 class="mb-2 flex items-baseline gap-2 font-display text-2xl font-bold text-ink">
      <span class="text-violet-500" aria-hidden="true">▸</span>
      projects/
    </h1>
    <p class="text-sm text-ink-soft">
      {t(lang, "projectsCount", { n: projects.length })}
    </p>
  </header>

  {
    projects.length === 0 ? (
      <p class="code-block p-5 text-sm text-ink-faint">
        {t(lang, "projectsEmpty")}
      </p>
    ) : (
      <div class="grid gap-4 sm:grid-cols-2" data-reveal>
        {projects.map((project) => (
          <ProjectCard project={project} lang={lang} />
        ))}
      </div>
    )
  }
</RepoLayout>
