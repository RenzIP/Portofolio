---
/**
 * CommandPalette — palet perintah (Ctrl+K / Cmd+K) untuk navigasi cepat.
 * Vanilla JS, tanpa framework. Ringan dan bisa diakses keyboard.
 */
import { getCollection } from "astro:content";
import { fileTree, socials } from "../data/site";
import {
  getLang,
  localizePath,
  navHintKey,
  projectLang,
  projectSlug,
  t,
  type Lang,
} from "../i18n/utils";

interface Props {
  lang?: Lang;
}

const lang = getLang(Astro.props.lang);

/** Kata kunci pencarian: judul + hint + slug/tag, semuanya huruf kecil. */
const searchKey = (...parts: string[]) => parts.join(" ").toLowerCase();

const pageCommands = fileTree.flatMap((group) =>
  group.files.map((f) => {
    const hint = t(lang, navHintKey[f.path] ?? "navHome");
    return {
      label: f.label,
      hint,
      href: localizePath(f.path, lang),
      kind: "file" as const,
      external: false,
      search: searchKey(f.label, hint),
    };
  }),
);

// Proyek ikut bisa dicari dari palet — pengunjung biasanya mencari nama
// proyek, bukan nama file. Hanya entri bahasa halaman ini yang ditampilkan.
const projectCommands = (await getCollection("projects"))
  .filter((p) => projectLang(p.id) === lang)
  .sort((a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0))
  .map((p) => ({
    label: p.data.title,
    hint: p.data.tags.slice(0, 3).join(" · "),
    href: localizePath(`/projects/${projectSlug(p.id)}`, lang),
    kind: "project" as const,
    external: false,
    search: searchKey(p.data.title, projectSlug(p.id), ...p.data.tags),
  }));

const linkCommands = socials.map((s) => ({
  label: s.label,
  hint: s.handle,
  href: s.href,
  kind: "link" as const,
  external: true,
  search: searchKey(s.label, s.handle),
}));

const sections = [
  { key: "pages", label: t(lang, "cmdkPages"), commands: pageCommands },
  { key: "projects", label: t(lang, "cmdkProjects"), commands: projectCommands },
  // Tautan eksternal tidak perlu judul grup; ikon ↗ sudah membedakannya.
  { key: "links", label: undefined, commands: linkCommands },
];
---

<div
  id="cmdk"
  class="fixed inset-0 z-50 hidden items-start justify-center pt-[12vh]"
  role="dialog"
  aria-modal="true"
  aria-label={t(lang, "cmdkAria")}
>
  <!-- backdrop -->
  <div
    id="cmdk-backdrop"
    class="absolute inset-0 bg-ink/20 backdrop-blur-[2px]"
  ></div>

  <!-- panel -->
  <div
    class="relative mx-4 w-full max-w-lg overflow-hidden rounded-md border border-rule-strong bg-paper shadow-lift"
  >
    <div class="flex items-center gap-2 border-b border-rule px-3">
      <span class="text-xs text-ink-faint only-mac" aria-hidden="true">⌘</span>
      <span class="text-xs text-ink-faint only-pc" aria-hidden="true">Ctrl</span>
      <input
        id="cmdk-input"
        type="text"
        autocomplete="off"
        spellcheck="false"
        placeholder={t(lang, "cmdkPlaceholder")}
        class="w-full bg-transparent py-3 text-sm text-ink outline-none placeholder:text-ink-faint"
        aria-controls="cmdk-list"
        aria-autocomplete="list"
        role="combobox"
        aria-expanded="true"
      />
      <kbd
        class="shrink-0 rounded-xs border border-rule px-1.5 py-0.5 text-[0.65rem] text-ink-faint"
      >
        esc
      </kbd>
    </div>

    <ul
      id="cmdk-list"
      class="thin-scroll max-h-72 overflow-y-auto py-1"
      role="listbox"
      aria-label={t(lang, "cmdkResultsAria")}
    >
      {
        sections.map((section) => (
          <li role="group" aria-label={section.label} data-cmdk-group={section.key}>
            {section.label && (
              <p class="meta-label px-3 pt-2 pb-1 text-[0.62rem]">
                {section.label}
              </p>
            )}
            <ul role="none">
              {section.commands.map((cmd) => (
                <li role="option" aria-selected="false">
                  <a
                    href={cmd.href}
                    target={cmd.external ? "_blank" : undefined}
                    rel={cmd.external ? "noopener noreferrer" : undefined}
                    data-cmdk-item
                    data-label={cmd.search}
                    class="flex items-center gap-3 px-3 py-2 text-sm text-ink-soft data-[active=true]:bg-accent-50 data-[active=true]:text-accent-800"
                  >
                    <span
                      class="shrink-0 text-xs text-ink-faint"
                      aria-hidden="true"
                    >
                      {cmd.kind === "file"
                        ? "·"
                        : cmd.kind === "project"
                          ? "▸"
                          : "↗"}
                    </span>
                    <span class="truncate font-medium">{cmd.label}</span>
                    <span class="ml-auto truncate text-xs text-ink-faint">
                      {cmd.hint}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
      <li
        id="cmdk-empty"
        class="hidden px-3 py-6 text-center text-sm text-ink-faint"
      >
        {t(lang, "cmdkEmpty")}
      </li>
    </ul>

    <div
      class="flex items-center gap-4 border-t border-rule px-3 py-2 text-[0.65rem] text-ink-faint"
    >
      <span class="flex items-center gap-1">
        <kbd class="rounded-xs border border-rule px-1 py-px">↑</kbd>
        <kbd class="rounded-xs border border-rule px-1 py-px">↓</kbd>
        {t(lang, "cmdkSelect")}
      </span>
      <span class="flex items-center gap-1">
        <kbd class="rounded-xs border border-rule px-1 py-px">↵</kbd>
        {t(lang, "cmdkOpen")}
      </span>
    </div>
  </div>
</div>

<script>
  // Dipanggil ulang setiap navigasi (view transitions) & saat load pertama.
  const initCmdk = () => {
    const cmdk = document.getElementById("cmdk") as HTMLDivElement | null;
    const input = document.getElementById(
      "cmdk-input",
    ) as HTMLInputElement | null;
    const list = document.getElementById("cmdk-list") as HTMLUListElement | null;
    const empty = document.getElementById(
      "cmdk-empty",
    ) as HTMLLIElement | null;
    const backdrop = document.getElementById(
      "cmdk-backdrop",
    ) as HTMLDivElement | null;

    if (!cmdk || !input || !list) return;

    const allItems = Array.from(
      list.querySelectorAll<HTMLAnchorElement>("[data-cmdk-item]"),
    );
    const groups = Array.from(
      list.querySelectorAll<HTMLElement>("[data-cmdk-group]"),
    );
    let visible: HTMLAnchorElement[] = [...allItems];
    let activeIndex = 0;

    const setActive = (i: number) => {
      if (visible.length === 0) return;
      activeIndex = (i + visible.length) % visible.length;
      visible.forEach((el, idx) => {
        const isActive = idx === activeIndex;
        el.dataset.active = String(isActive);
        el.parentElement?.setAttribute("aria-selected", String(isActive));
        if (isActive) el.scrollIntoView({ block: "nearest" });
      });
    };

    const filter = () => {
      const q = input.value.trim().toLowerCase();
      visible = [];
      allItems.forEach((el) => {
        const match = q === "" || (el.dataset.label ?? "").includes(q);
        el.parentElement!.classList.toggle("hidden", !match);
        if (match) visible.push(el);
      });
      // Sembunyikan judul grup yang seluruh itemnya tersaring habis.
      groups.forEach((group) => {
        const hasMatch = Array.from(
          group.querySelectorAll<HTMLAnchorElement>("[data-cmdk-item]"),
        ).some((el) => visible.includes(el));
        group.classList.toggle("hidden", !hasMatch);
      });
      if (empty) empty.classList.toggle("hidden", visible.length !== 0);
      activeIndex = 0;
      setActive(0);
    };

    const open = () => {
      cmdk.classList.remove("hidden");
      cmdk.classList.add("flex");
      document.body.style.overflow = "hidden";
      input.value = "";
      filter();
      input.focus();
    };

    const close = () => {
      cmdk.classList.add("hidden");
      cmdk.classList.remove("flex");
      document.body.style.overflow = "";
    };

    // Simpan referensi agar handler global bisa memakai elemen terbaru.
    (window as any).__cmdk = {
      open,
      close,
      isOpen: () => !cmdk.classList.contains("hidden"),
    };

    input.addEventListener("input", filter);

    // Navigasi keyboard di dalam daftar (panah + enter).
    input.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown") {
        e.preventDefault();
        setActive(activeIndex + 1);
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        setActive(activeIndex - 1);
      } else if (e.key === "Enter") {
        e.preventDefault();
        visible[activeIndex]?.click();
      }
    });

    backdrop?.addEventListener("click", close);

    document.getElementById("cmdk-trigger")?.addEventListener("click", open);
  };

  // Handler global: dipasang SEKALI saja (modul dievaluasi sekali).
  if (!(window as any).__cmdkBound) {
    (window as any).__cmdkBound = true;
    window.addEventListener("keydown", (e) => {
      const api = (window as any).__cmdk;
      if (!api) return;
      const isOpen = api.isOpen();

      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "k") {
        e.preventDefault();
        isOpen ? api.close() : api.open();
        return;
      }
      if (!isOpen) return;

      if (e.key === "Escape") {
        e.preventDefault();
        api.close();
      }
    });
  }

  document.addEventListener("astro:page-load", initCmdk);
</script>
