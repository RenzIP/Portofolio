---
/**
 * TopBar — bilah atas bergaya "window/editor tab" dengan path repo.
 */
import { repo } from "../data/site";
import { canonicalPath, getLang, localizePath, t, type Lang } from "../i18n/utils";
import LanguageSwitcher from "./LanguageSwitcher.astro";

interface Props {
  lang?: Lang;
}

const lang = getLang(Astro.props.lang);

// Label path dihitung dari path kanonik (tanpa prefix bahasa), supaya
// "/en/log" tetap tampil sebagai "log.md", bukan "en/log.md".
const current = canonicalPath(Astro.url.pathname);
const pathLabel =
  current === "/"
    ? "ruang/"
    : current === "/projects"
      ? "projects/"
      : current.startsWith("/projects/")
        ? `projects/${current.split("/").pop()}.md`
        : current.replace("/", "") + ".md";
---

<header
  class="sticky top-0 z-40 border-b border-rule bg-paper/85 backdrop-blur-sm"
>
  <div
    class="mx-auto flex h-11 w-full max-w-6xl items-center gap-2 px-4 text-xs"
  >
    <!-- breadcrumb gaya path -->
    <div class="flex min-w-0 items-center gap-1.5">
      <span class="shrink-0 text-ink-faint" aria-hidden="true">~</span>
      <span class="hidden shrink-0 text-ink-soft sm:inline">{repo.owner}</span>
      <span class="hidden shrink-0 text-ink-faint sm:inline">/</span>
      <a
        href={localizePath("/", lang)}
        class="shrink-0 font-medium text-ink transition-colors hover:text-accent-700"
      >
        {repo.name}
      </a>
      <span class="shrink-0 text-ink-faint">/</span>
      <span class="truncate text-ink-faint" data-path-label>{pathLabel}</span>
    </div>

    <div class="ml-auto flex shrink-0 items-center gap-2">
      <!-- tombol palet perintah -->
      <button
        id="cmdk-trigger"
        type="button"
        class="flex items-center gap-1.5 rounded-sm border border-rule px-2 py-1 text-[0.7rem] text-ink-faint transition-colors hover:border-rule-strong hover:text-ink"
        aria-label={t(lang, "searchAria")}
      >
        <span class="only-mac" aria-hidden="true">⌘</span>
        <span class="only-pc" aria-hidden="true">Ctrl</span>
        <span class="hidden sm:inline">{t(lang, "search")}</span>
        <kbd
          class="ml-0.5 hidden rounded-xs border border-rule bg-paper-soft px-1 py-px font-mono text-[0.6rem] sm:inline"
        >
          K
        </kbd>
      </button>

      <LanguageSwitcher lang={lang} />

      <span class="chip hidden sm:inline-flex border-verdigris-200 bg-verdigris-50 text-verdigris-700 font-semibold font-mono text-[0.65rem]">
        <svg
          viewBox="0 0 16 16"
          class="size-3 fill-verdigris-600"
          aria-hidden="true"
        >
          <path
            d="M11.75 2.5a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5Zm-2.25.75a2.25 2.25 0 1 1 3 2.122V6A2.5 2.5 0 0 1 10 8.5H6a1 1 0 0 0-1 1v1.128a2.251 2.251 0 1 1-1.5 0V5.372a2.25 2.25 0 1 1 1.5 0v1.836A2.492 2.492 0 0 1 6 7h4a1 1 0 0 0 1-1v-.628A2.25 2.25 0 0 1 9.5 3.25Z"
          ></path>
        </svg>
        {repo.branch}
      </span>
    </div>
  </div>
</header>
