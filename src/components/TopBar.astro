---
/**
 * TopBar — bilah atas bergaya "window/editor tab" dengan path repo.
 */
import { repo } from "../data/site";

const current = Astro.url.pathname;
const pathLabel =
  current === "/"
    ? "README.md"
    : current === "/projects"
      ? "projects/"
      : current.startsWith("/projects/")
        ? `projects/${current.split("/").pop()}.md`
        : current.replace("/", "") + ".md";
---

<header
  class="sticky top-0 z-40 border-b border-rule bg-paper/85 backdrop-blur-sm"
>
  <div
    class="mx-auto flex h-11 w-full max-w-6xl items-center gap-3 px-4 text-xs"
  >
    <!-- breadcrumb gaya path -->
    <div class="flex min-w-0 items-center gap-1.5">
      <span class="shrink-0 text-ink-faint" aria-hidden="true">⌥</span>
      <span class="shrink-0 text-ink-soft">{repo.owner}</span>
      <span class="shrink-0 text-ink-faint">/</span>
      <a
        href="/"
        class="shrink-0 font-medium text-ink transition-colors hover:text-accent-700"
      >
        {repo.name}
      </a>
      <span class="shrink-0 text-ink-faint">/</span>
      <span class="truncate text-ink-faint">{pathLabel}</span>
    </div>

    <span class="ml-auto hidden shrink-0 items-center gap-1.5 sm:flex">
      <span class="chip">
        <svg viewBox="0 0 16 16" class="size-3 fill-violet-500" aria-hidden="true">
          <path
            d="M11.75 2.5a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5Zm-2.25.75a2.25 2.25 0 1 1 3 2.122V6A2.5 2.5 0 0 1 10 8.5H6a1 1 0 0 0-1 1v1.128a2.251 2.251 0 1 1-1.5 0V5.372a2.25 2.25 0 1 1 1.5 0v1.836A2.492 2.492 0 0 1 6 7h4a1 1 0 0 0 1-1v-.628A2.25 2.25 0 0 1 9.5 3.25Z"
          ></path>
        </svg>
        {repo.branch}
      </span>
    </span>
  </div>
</header>
