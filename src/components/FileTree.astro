---
/**
 * FileTree — sidebar navigasi bergaya file explorer.
 *
 * `path` di site.ts selalu path kanonik (tanpa prefix bahasa);
 * `localizePath` yang menambahkan prefix sesuai bahasa halaman.
 * `data-nav-path` menyimpan path kanonik supaya NavSync bisa menyorot
 * tautan aktif setelah navigasi client-side, apa pun bahasanya.
 */
import { fileTree } from "../data/site";
import { NAV_ACTIVE_FILE, NAV_IDLE_FILE } from "../data/nav";
import { getLang, localizePath, navHintKey, t, type Lang } from "../i18n/utils";

interface Props {
  lang?: Lang;
}

const lang = getLang(Astro.props.lang);
const current = Astro.url.pathname;
const home = localizePath("/", lang);
const isActive = (path: string) => {
  const href = localizePath(path, lang);
  return href === home
    ? current === home || current === home.replace(/\/$/, "")
    : current.startsWith(href);
};
---

<nav aria-label={t(lang, "filesAria")} class="text-sm" data-file-tree>
  <p class="meta-label mb-3 px-2">Explorer</p>

  {
    fileTree.map((group) => (
      <div class="mb-2">
        <p class="flex items-center gap-1.5 px-2 py-1 text-xs text-ink-soft">
          <span aria-hidden="true">▾</span>
          <span class="font-medium">{group.dir}</span>
        </p>
        <ul class="ml-3 border-l border-rule">
          {group.files.map((file) => {
            const active = isActive(file.path);
            return (
              <li>
                <a
                  href={localizePath(file.path, lang)}
                  data-nav-link={localizePath(file.path, lang)}
                  data-nav-path={file.path}
                  title={t(lang, navHintKey[file.path] ?? "navHome")}
                  aria-current={active ? "page" : undefined}
                  class:list={[
                    "flex items-center gap-2 border-l-2 py-1.5 pr-2 pl-3 text-xs transition-colors rounded-r",
                    active ? NAV_ACTIVE_FILE : NAV_IDLE_FILE,
                  ]}
                >
                  <span
                    class:list={[
                      "shrink-0",
                      file.isDir ? "text-verdigris-600 font-bold" : "text-ink-faint",
                    ]}
                    aria-hidden="true"
                  >
                    {file.isDir ? "▸" : "·"}
                  </span>
                  <span class="truncate">{file.label}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ))
  }
</nav>
