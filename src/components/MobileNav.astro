---
/**
 * MobileNav — navigasi horizontal untuk layar kecil.
 * Sidebar file tree disembunyikan di mobile, jadi ini penggantinya.
 */
import { fileTree } from "../data/site";
import { NAV_ACTIVE_MOBILE, NAV_IDLE_MOBILE } from "../data/nav";
import { getLang, localizePath, navHintKey, t, type Lang } from "../i18n/utils";

interface Props {
  lang?: Lang;
}

const lang = getLang(Astro.props.lang);
const current = Astro.url.pathname;
const home = localizePath("/", lang);
const isActive = (path: string) => {
  const href = localizePath(path, lang);
  return href === home
    ? current === home || current === home.replace(/\/$/, "")
    : current.startsWith(href);
};

const files = fileTree.flatMap((group) => group.files);
---

<nav
  aria-label={t(lang, "navAria")}
  class="sticky top-11 z-30 -mx-4 mb-6 border-b border-rule bg-paper/90 backdrop-blur-sm md:hidden"
>
  <div class="relative">
    <ul class="thin-scroll flex gap-1 overflow-x-auto py-2 pr-6 text-xs">
      {
        files.map((file) => {
          const active = isActive(file.path);
          return (
            <li class="shrink-0">
              <a
                href={localizePath(file.path, lang)}
                data-nav-link={localizePath(file.path, lang)}
                data-nav-path={file.path}
                title={t(lang, navHintKey[file.path] ?? "navHome")}
                aria-current={active ? "page" : undefined}
                class:list={[
                  "flex items-center gap-1.5 rounded-sm border px-2.5 py-1.5 whitespace-nowrap transition-colors",
                  active ? NAV_ACTIVE_MOBILE : NAV_IDLE_MOBILE,
                ]}
              >
                <span
                  class:list={[
                    "text-[0.6rem]",
                    file.isDir ? "text-violet-500" : "text-ink-faint",
                  ]}
                  aria-hidden="true"
                >
                  {file.isDir ? "▸" : "·"}
                </span>
                {file.label}
              </a>
            </li>
          );
        })
      }
    </ul>
    <!-- petunjuk: masih ada item di kanan (bisa di-scroll) -->
    <span
      class="pointer-events-none absolute inset-y-0 right-0 w-8 bg-gradient-to-l from-paper to-transparent"
      aria-hidden="true"
    ></span>
  </div>
</nav>
