---
/**
 * StatusBar — bilah bawah bergaya status bar editor.
 */
import { repo } from "../data/site";
import { getLang, t, type Lang } from "../i18n/utils";

interface Props {
  lang?: Lang;
}

const lang = getLang(Astro.props.lang);
const year = new Date().getFullYear();
---

<footer
  class="border-t border-rule bg-paper-soft text-[0.7rem] text-ink-faint"
>
  <div
    class="mx-auto flex w-full max-w-6xl flex-wrap items-center gap-x-4 gap-y-1 px-4 py-2"
  >
    <span class="flex items-center gap-1.5">
      <svg viewBox="0 0 16 16" class="size-3 fill-violet-500" aria-hidden="true">
        <path
          d="M11.75 2.5a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5Zm-2.25.75a2.25 2.25 0 1 1 3 2.122V6A2.5 2.5 0 0 1 10 8.5H6a1 1 0 0 0-1 1v1.128a2.251 2.251 0 1 1-1.5 0V5.372a2.25 2.25 0 1 1 1.5 0v1.836A2.492 2.492 0 0 1 6 7h4a1 1 0 0 0 1-1v-.628A2.25 2.25 0 0 1 9.5 3.25Z"
        ></path>
      </svg>
      <span data-status-branch>{repo.branch}</span>
    </span>

    <span class="flex items-center gap-1.5">
      <span class="size-1.5 rounded-full bg-add" aria-hidden="true"></span>
      {t(lang, "status")}
    </span>

    <!-- jam live: repo berasa "hidup", update tiap 30 detik -->
    <span class="hidden items-center gap-1.5 sm:flex" title={t(lang, "localTime")}>
      <span aria-hidden="true">◷</span>
      <time data-live-clock>--:--</time>
    </span>

    <span class="ml-auto">© {year} {repo.owner}</span>
    <span class="hidden sm:inline">UTF-8 · LF · Astro</span>
  </div>
</footer>

<script>
  // Jam live di status bar + sinkron label branch dengan halaman aktif.
  const initStatusBar = () => {
    // --- jam (update tiap 30 dtk, cukup untuk jam:menit) ---
    const clock = document.querySelector<HTMLElement>("[data-live-clock]");
    const tickClock = () => {
      if (!clock) return;
      const now = new Date();
      const hh = String(now.getHours()).padStart(2, "0");
      const mm = String(now.getMinutes()).padStart(2, "0");
      clock.textContent = `${hh}:${mm}`;
      clock.setAttribute("datetime", now.toISOString());
    };
    tickClock();
    if (!(window as any).__clockBound) {
      (window as any).__clockBound = true;
      setInterval(tickClock, 30_000);
    }

    // --- label branch mengikuti halaman ditangani NavSync (satu tempat saja,
    //     supaya logika path ber-prefix bahasa tidak terduplikasi) ---
  };

  document.addEventListener("astro:page-load", initStatusBar);
</script>
