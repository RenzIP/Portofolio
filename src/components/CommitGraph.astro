---
/**
 * CommitGraph — timeline bergaya `git log --graph`.
 * Menampilkan dot commit, garis vertikal, hash, refs, dan pesan.
 */

interface Commit {
  hash: string;
  date: string;
  refs: readonly string[];
  title: string;
  body: string;
  stack: readonly string[];
}

interface Props {
  commits: readonly Commit[];
}

const { commits } = Astro.props;
---

<ol class="relative" data-commit-graph>
  {
    commits.map((commit, i) => {
      const isHead =
        commit.refs.some((r) => r.toUpperCase() === "HEAD") || i === 0;
      return (
        <li class="relative flex gap-4 pb-8 last:pb-0">
          {/* kolom graph: garis + dot */}
          <div class="relative flex w-4 shrink-0 justify-center">
            {i !== commits.length - 1 && (
              <span
                class="commit-line commit-line-draw absolute top-3 bottom-0 w-px bg-rule-strong"
                aria-hidden="true"
              />
            )}
            <span
              class:list={[
                "relative mt-1 size-3 shrink-0 rounded-full border-2 border-paper bg-accent-500 ring-1 ring-accent-500",
                isHead && "head-dot",
              ]}
              data-head-dot={isHead ? "" : undefined}
              aria-hidden="true"
            />
          </div>

          <div class="min-w-0 flex-1">
            <div class="mb-1 flex flex-wrap items-center gap-2">
              <button
                type="button"
                data-copy-hash={commit.hash}
                title={`Salin hash ${commit.hash}`}
                class="cursor-pointer rounded-xs font-mono text-xs text-accent-700 transition-colors hover:bg-accent-50 hover:text-accent-800 focus-visible:outline-2 focus-visible:outline-accent-500"
              >
                <code>{commit.hash}</code>
              </button>
              {commit.refs.map((ref) => (
                <span class="chip border-accent-300 bg-accent-50 text-accent-800">
                  {ref}
                </span>
              ))}
              <span class="ml-auto text-xs text-ink-faint">{commit.date}</span>
            </div>

          <h3 class="mb-1 font-display text-base font-semibold text-ink">
            {commit.title}
          </h3>
          <p class="mb-3 text-sm leading-relaxed text-ink-soft">{commit.body}</p>

          <ul class="flex flex-wrap gap-1.5">
            {commit.stack.map((tech) => (
              <li class="chip">{tech}</li>
            ))}
          </ul>
        </div>
      </li>
      );
    })
  }
</ol>

<script>
  // 1. Klik hash → salin ke clipboard + toast kecil "tersalin ✓".
  // 2. Pulse dot HEAD berhenti saat graph offscreen (hemat animasi).
  // 3. Garis vertikal tergambar (class .drawn) saat graph masuk viewport.
  const initCommitGraph = () => {
    const graphs = document.querySelectorAll<HTMLElement>("[data-commit-graph]");
    graphs.forEach((graph) => {
      if (graph.dataset.bound === "1") return;
      graph.dataset.bound = "1";

      // --- salin hash (dengan fallback untuk konteks non-secure) ---
      graph.addEventListener("click", async (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-copy-hash]");
        if (!btn) return;
        const hash = btn.dataset.copyHash ?? "";
        const code = btn.querySelector("code");
        const original = code?.textContent ?? hash;
        const done = (ok: boolean) => {
          if (code) code.textContent = ok ? "tersalin ✓" : "gagal";
          setTimeout(() => {
            if (code) code.textContent = original;
          }, 1400);
        };
        try {
          if (navigator.clipboard?.writeText) {
            await navigator.clipboard.writeText(hash);
            done(true);
          } else {
            throw new Error("no-clipboard");
          }
        } catch {
          // Fallback: textarea sementara + execCommand (HTTP non-lokal / browser lama).
          try {
            const ta = document.createElement("textarea");
            ta.value = hash;
            ta.style.position = "fixed";
            ta.style.opacity = "0";
            document.body.appendChild(ta);
            ta.select();
            const ok = document.execCommand("copy");
            ta.remove();
            done(ok);
          } catch {
            done(false);
          }
        }
      });

      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (reduce || !("IntersectionObserver" in window)) {
        graph.querySelectorAll(".commit-line-draw").forEach((l) => l.classList.add("drawn"));
        return;
      }

      // --- pause pulse saat offscreen ---
      const headDot = graph.querySelector(".head-dot");
      const lines = graph.querySelectorAll(".commit-line-draw");
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.target === graph) {
              headDot?.classList.toggle("head-dot-paused", !entry.isIntersecting);
            } else if (entry.isIntersecting) {
              entry.target.classList.add("drawn");
              io.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.05 },
      );
      io.observe(graph);
      lines.forEach((l) => io.observe(l));
    });
  };

  document.addEventListener("astro:page-load", initCommitGraph);
</script>
