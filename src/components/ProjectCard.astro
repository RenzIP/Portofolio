---
/**
 * ProjectCard — kartu proyek bergaya entri file di dalam repo.
 */
import type { CollectionEntry } from "astro:content";
import {
  getLang,
  localizePath,
  projectSlug,
  t,
  type Lang,
} from "../i18n/utils";

interface Props {
  project: CollectionEntry<"projects">;
  lang?: Lang;
}

const { project } = Astro.props;
const lang = getLang(Astro.props.lang);
const { title, summary, tags, date, repo, demo, status } = project.data;
const slug = projectSlug(project.id);

const formattedDate = date?.toLocaleDateString(lang === "id" ? "id-ID" : lang, {
  year: "numeric",
  month: "short",
});

const statusTone: Record<string, string> = {
  aktif: "border-add/40 bg-add-bg text-add",
  selesai: "border-rule-strong bg-paper-soft text-ink-soft",
  arsip: "border-rule-strong bg-paper-soft text-ink-faint",
};

/** Nilai status di frontmatter tetap bahasa Indonesia (nilai data);
 *  yang diterjemahkan hanya tampilannya. */
const statusLabel: Record<string, "projActive" | "projDone" | "projArchived"> = {
  aktif: "projActive",
  selesai: "projDone",
  arsip: "projArchived",
};
---

<article
  class="group relative flex h-full flex-col overflow-hidden rounded-lg border border-rule bg-paper transition-all duration-300 hover:border-accent-500 hover:shadow-lift"
>
  <div class="flex flex-1 flex-col p-5">
    <header class="mb-3 flex items-start gap-2.5">
      <span class="mt-1 size-2 rounded-full bg-rose-500 shrink-0 group-hover:bg-accent-500 transition-colors" aria-hidden="true"></span>
      <div class="min-w-0 flex-1">
        <h3 class="font-display text-base font-bold text-ink group-hover:text-verdigris-600 transition-colors">
          <a
            href={localizePath(`/projects/${slug}`, lang)}
            class="after:absolute after:inset-0"
          >
            {title}
          </a>
        </h3>
        <div class="mt-1 flex flex-wrap items-center gap-2 text-xs text-ink-faint">
          {
            date && (
              <time datetime={date.toISOString()}>{formattedDate}</time>
            )
          }
          {
            status && (
              <span
                class:list={[
                  "rounded-full border px-2 py-0.5 text-[0.65rem] font-medium tracking-wide uppercase",
                  statusTone[status] ?? statusTone.selesai,
                ]}
              >
                {t(lang, statusLabel[status] ?? "projDone")}
              </span>
            )
          }
        </div>
      </div>
    </header>

    <p class="mb-4 flex-1 text-sm leading-relaxed text-ink-soft">
      {summary}
    </p>

    <ul class="mb-4 flex flex-wrap gap-1.5">
      {tags.map((tag) => <li class="chip border-rule bg-paper-soft text-[0.7rem] text-verdigris-700 font-mono">{tag}</li>)}
    </ul>

    <footer class="relative z-10 flex items-center justify-between border-t border-rule pt-3 text-xs">
      {
        repo && (
          <a
            href={repo}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 font-mono text-ink-faint transition-colors hover:text-accent-700"
          >
            <span>{t(lang, "projSource")}</span>
          </a>
        )
      }
      {
        demo && (
          <a
            href={demo}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 font-medium text-verdigris-600 transition-colors hover:text-verdigris-800"
          >
            <span>{t(lang, "projLive")}</span>
          </a>
        )
      }
    </footer>
  </div>
</article>
