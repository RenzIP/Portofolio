---
/**
 * NavSync — sinkronisasi state aktif navigasi setelah navigasi client-side.
 *
 * Masalah: elemen dengan `transition:persist` (TopBar, sidebar FileTree)
 * tidak di-render ulang saat pindah halaman via ClientRouter, sehingga
 * highlight aktif + breadcrumb terjebak di halaman pertama yang dibuka.
 *
 * Solusi: tiap `astro:page-load`, hitung ulang dari `location.pathname`
 * dan update DOM yang persisten.
 *
 * Catatan i18n: URL halaman punya prefix bahasa ("/en/log"), sedangkan
 * tautan navigasi menyimpan path kanonik di `data-nav-path`. Jadi path
 * dari `location` dinormalkan dulu (prefix bahasa dibuang) sebelum
 * dibandingkan — kalau tidak, "/en/log" tidak akan pernah cocok dengan "/log".
 */
---

<script>
  // @ts-nocheck
  // Kelas state dipakai bersama dengan render SSR (FileTree & MobileNav),
  // supaya highlight tidak berubah rupa setelah navigasi client-side.
  import {
    NAV_ACTIVE_FILE,
    NAV_IDLE_FILE,
    NAV_ACTIVE_MOBILE,
    NAV_IDLE_MOBILE,
  } from "../data/nav";

  // Pola sama seperti ScrollProgress: guard global agar listener sekali pasang.

  const ACTIVE_FILE = NAV_ACTIVE_FILE;
  const IDLE_FILE = NAV_IDLE_FILE;
  const ACTIVE_MOBILE = NAV_ACTIVE_MOBILE;
  const IDLE_MOBILE = NAV_IDLE_MOBILE;

  // Daftar prefix bahasa diambil dari <html data-locale-prefixes="en ja zh">,
  // jadi menambah bahasa baru tidak perlu menyentuh file ini.
  const prefixes = (document.documentElement.dataset.localePrefixes ?? "")
    .split(/\s+/)
    .filter(Boolean);

  const canonicalPath = (pathname) => {
    const segs = pathname.split("/").filter(Boolean);
    if (segs.length && prefixes.includes(segs[0])) segs.shift();
    return segs.length ? "/" + segs.join("/") : "/";
  };

  const setClasses = (el, active) => {
    const inFileTree = !!el.closest("[data-file-tree]");
    const on = (inFileTree ? ACTIVE_FILE : ACTIVE_MOBILE).split(" ");
    const off = (inFileTree ? IDLE_FILE : IDLE_MOBILE).split(" ");
    el.classList.remove(...(active ? off : on));
    el.classList.add(...(active ? on : off));
    if (active) {
      el.setAttribute("aria-current", "page");
    } else {
      el.removeAttribute("aria-current");
    }
  };

  const isActivePath = (navPath, current) =>
    navPath === "/" ? current === "/" : current.startsWith(navPath);

  const fileLabel = (canonical) => {
    if (canonical === "/") return "README.md";
    if (canonical === "/projects") return "projects/";
    if (canonical.startsWith("/projects/")) {
      const slug = canonical.split("/").filter(Boolean).pop() ?? "";
      return `projects/${slug}.md`;
    }
    return canonical.replace(/^\//, "") + ".md";
  };

  const syncNav = () => {
    const current = canonicalPath(window.location.pathname);

    // Semua link nav (FileTree persist + MobileNav yang di-swap).
    document.querySelectorAll("a[data-nav-path]").forEach((a) => {
      const navPath = a.getAttribute("data-nav-path") ?? "";
      setClasses(a, isActivePath(navPath, current));
    });

    // Breadcrumb di TopBar (persist).
    const crumb = document.querySelector("[data-path-label]");
    if (crumb) crumb.textContent = fileLabel(current);

    // Label branch di status bar mengikuti segmen pertama path kanonik.
    const branch = document.querySelector("[data-status-branch]");
    if (branch) {
      const seg = current.split("/").filter(Boolean)[0];
      branch.textContent = seg ?? branch.textContent;
    }
  };

  document.addEventListener("astro:page-load", syncNav);

  if (!window.__navSyncBound) {
    window.__navSyncBound = true;
    // Fallback kalau event Astro belum kepasang (mis. load pertama lambat).
    if (document.readyState !== "loading") syncNav();
    else document.addEventListener("DOMContentLoaded", syncNav, { once: true });
  }
</script>
