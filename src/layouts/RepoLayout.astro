---
/**
 * RepoLayout — kerangka utama bergaya repository:
 * top bar + sidebar file tree + area "editor" dengan nomor baris.
 */
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import TopBar from "../components/TopBar.astro";
import FileTree from "../components/FileTree.astro";
import MobileNav from "../components/MobileNav.astro";
import StatusBar from "../components/StatusBar.astro";
import CommandPalette from "../components/CommandPalette.astro";
import GitTerminal from "../components/GitTerminal.astro";
import BootScreen from "../components/BootScreen.astro";
import ScrollProgress from "../components/ScrollProgress.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
import { repo } from "../data/site";

interface Props {
  title: string;
  description?: string;
  /** Nama file yang ditampilkan di header editor. */
  file: string;
  /** Slug gambar OG (lihat src/pages/open-graph/[...route].ts). */
  ogSlug?: string;
  /** Data tambahan untuk structured data (mis. proyek). */
  schemaExtra?: Record<string, unknown>;
  /** Cegah halaman diindeks mesin pencari (mis. 404). */
  noindex?: boolean;
}

const {
  title,
  description = repo.tagline,
  file,
  ogSlug,
  schemaExtra,
  noindex = false,
} = Astro.props;

const siteName = `${repo.owner}/${repo.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);

// Gambar OG: pakai slug eksplisit kalau ada, kalau tidak turunkan dari path.
const pathSegments = Astro.url.pathname.split("/").filter(Boolean);
const derivedSlug =
  Astro.url.pathname === "/"
    ? "home"
    : pathSegments[0] === "projects" && pathSegments.length > 1
      ? `project-${pathSegments[1]}`
      : pathSegments.join("-");
const ogImage = new URL(`/open-graph/${ogSlug ?? derivedSlug}.png`, canonical).href;

/* ---------- Structured data (JSON-LD) ---------- */
// Person: identitas pemilik situs, dipakai di semua halaman.
const personSchema = {
  "@type": "Person",
  "@id": `${canonical.origin}/#person`,
  name: repo.owner,
  jobTitle: "Full-Stack Web Developer",
  description: repo.tagline,
  url: canonical.origin,
  email: `mailto:${repo.email}`,
  knowsAbout: [
    "Web Development",
    "Frontend Development",
    "Backend Development",
    "TypeScript",
    "Astro",
    "Flutter",
  ],
  sameAs: ["https://github.com/RenzIP"],
};

// WebSite + WebPage, ditautkan ke Person.
const pageSchema = {
  "@type": pathSegments[0] === "projects" ? "CollectionPage" : "WebPage",
  "@id": `${canonical.href}#webpage`,
  url: canonical.href,
  name: `${title} · ${siteName}`,
  description,
  inLanguage: "id-ID",
  isPartOf: { "@id": `${canonical.origin}/#website` },
  about: { "@id": `${canonical.origin}/#person` },
  ...(schemaExtra ?? {}),
};

// Breadcrumb: beranda + segmen path.
const breadcrumbItems = [
  { name: "Home", item: canonical.origin },
  ...pathSegments.map((seg, i) => ({
    name: seg,
    item: new URL("/" + pathSegments.slice(0, i + 1).join("/"), canonical.origin)
      .href,
  })),
];
const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbItems.map((b, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: b.name,
    item: b.item,
  })),
};

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${canonical.origin}/#website`,
      url: canonical.origin,
      name: siteName,
      description: repo.tagline,
      inLanguage: "id-ID",
      publisher: { "@id": `${canonical.origin}/#person` },
    },
    personSchema,
    pageSchema,
    breadcrumbSchema,
  ],
};
---

<!doctype html>
<html lang="id" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />

    <title>{title} · {siteName}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={`${title} · ${siteName}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="id_ID" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} · ${siteName}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <!-- Structured data -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(jsonLd)}
    />

    <ClientRouter />

    <!-- Transisi halaman gaya "git checkout": konten lama meluncur sedikit
         ke kiri sambil memudar, konten baru masuk dari kanan. Durasi
         pendek supaya terasa responsif. ClientRouter Astro otomatis
         menonaktifkan semua animasi saat prefers-reduced-motion. -->
    <style is:global>
      @keyframes repo-out {
        from {
          opacity: 1;
          transform: translateX(0);
        }
        to {
          opacity: 0;
          transform: translateX(-18px);
        }
      }
      @keyframes repo-in {
        from {
          opacity: 0;
          transform: translateX(22px);
        }
        to {
          opacity: 1;
          transform: translateX(0);
        }
      }
    </style>
  </head>

  <body class="flex min-h-screen flex-col bg-paper">
    <BootScreen />
    <ScrollProgress />

    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded focus:bg-ink focus:px-3 focus:py-2 focus:text-xs focus:text-paper"
    >
      Lompat ke konten
    </a>

    <TopBar transition:persist="site-topbar" />

    <div class="mx-auto flex w-full max-w-6xl flex-1 gap-8 px-4 py-8">
      <!-- Sidebar: file tree (sembunyi di layar kecil) -->
      <aside class="hidden w-52 shrink-0 md:block" transition:persist="site-sidebar">
        <div class="sticky top-20">
          <FileTree />
        </div>
      </aside>

      <!-- Area editor -->
      <!-- Transisi custom "git checkout" via transition:animate (pola resmi
           astro:transitions): halaman lama keluar ke kiri, halaman baru
           masuk dari kanan. Mundur (back) dibalik arahnya. -->
      <main
        id="main"
        class="min-w-0 flex-1"
        transition:name="repo-main"
        transition:animate={{
          forwards: {
            old: {
              name: "repo-out",
              duration: "0.22s",
              easing: "cubic-bezier(0.33, 1, 0.68, 1)",
            },
            new: {
              name: "repo-in",
              duration: "0.32s",
              easing: "cubic-bezier(0.22, 1, 0.36, 1)",
            },
          },
          backwards: {
            old: {
              name: "repo-in",
              duration: "0.22s",
              easing: "cubic-bezier(0.33, 1, 0.68, 1)",
              direction: "reverse",
            },
            new: {
              name: "repo-out",
              duration: "0.32s",
              easing: "cubic-bezier(0.22, 1, 0.36, 1)",
              direction: "reverse",
            },
          },
        }}
      >
        <MobileNav />

        <!-- header file, seperti tab editor -->
        <div
          class="mb-6 flex items-center gap-2 border-b border-rule pb-3 text-xs text-ink-faint"
        >
          <span class="text-accent-600" aria-hidden="true">◆</span>
          <span class="font-medium text-ink">{file}</span>
          <span class="ml-auto hidden sm:inline">read-only</span>
        </div>

        <slot />
      </main>
    </div>

    <StatusBar />

    <CommandPalette />
    <GitTerminal />
    <ScrollReveal />
  </body>
</html>
