---
/**
 * RepoLayout — kerangka utama bergaya repository:
 * top bar + sidebar file tree + area "editor" dengan nomor baris.
 */
import "../styles/global.css";
import TopBar from "../components/TopBar.astro";
import FileTree from "../components/FileTree.astro";
import MobileNav from "../components/MobileNav.astro";
import StatusBar from "../components/StatusBar.astro";
import { repo } from "../data/site";

interface Props {
  title: string;
  description?: string;
  /** Nama file yang ditampilkan di header editor. */
  file: string;
}

const {
  title,
  description = repo.tagline,
  file,
} = Astro.props;

const siteName = `${repo.owner}/${repo.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />

    <title>{title} · {siteName}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} · ${siteName}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
  </head>

  <body class="flex min-h-screen flex-col bg-paper">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded focus:bg-ink focus:px-3 focus:py-2 focus:text-xs focus:text-paper"
    >
      Lompat ke konten
    </a>

    <TopBar />

    <div class="mx-auto flex w-full max-w-6xl flex-1 gap-8 px-4 py-8">
      <!-- Sidebar: file tree (sembunyi di layar kecil) -->
      <aside class="hidden w-52 shrink-0 md:block">
        <div class="sticky top-20">
          <FileTree />
        </div>
      </aside>

      <!-- Area editor -->
      <main id="main" class="min-w-0 flex-1">
        <MobileNav />

        <!-- header file, seperti tab editor -->
        <div
          class="mb-6 flex items-center gap-2 border-b border-rule pb-3 text-xs text-ink-faint"
        >
          <span class="text-accent-600" aria-hidden="true">◆</span>
          <span class="font-medium text-ink">{file}</span>
          <span class="ml-auto hidden sm:inline">read-only</span>
        </div>

        <slot />
      </main>
    </div>

    <StatusBar />
  </body>
</html>
