# Security & caching headers untuk Cloudflare Pages / Netlify.
# File ini otomatis dibaca oleh Cloudflare Pages (dan Netlify) dari folder output.

/*
  # --- Keamanan ---
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

  # CSP: tidak ada skrip pihak ketiga. Three.js dan scene.js dilayani dari
  # origin sendiri. 'unsafe-inline' diperlukan karena Astro meng-inline
  # script kecil (command palette, boot screen) ke HTML.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests

# --- Cache aset ber-hash (immutable, 1 tahun) ---
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# --- Font: cache lama ---
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# --- Runtime Ruang: Three.js stabil, scene.js ikut rilis ---
/vendor/*
  Cache-Control: public, max-age=2592000

/ruang/*
  Cache-Control: public, max-age=3600

# --- OG image: cache sedang (bisa berubah saat konten berubah) ---
/open-graph/*
  Cache-Control: public, max-age=86400

# --- HTML: selalu revalidasi ---
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# --- 404: jangan diindeks ---
/404.html
  X-Robots-Tag: noindex, nofollow
